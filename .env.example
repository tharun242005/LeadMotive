# ============================================================================
# LeadMotive — Server-Side Environment Variables
# ============================================================================
# Copy this file to .env.local and fill in the server-side secrets.
# Never prefix secrets with NEXT_PUBLIC_. Secrets must remain on the server.

# Primary AI Provider: Google Gemini (Server secret)
# Get a free key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional Secondary AI Provider: Groq (Server secret)
# Get an optional key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
